<mujoco model="cross_world">
  <!-- Coupling across two moving trees in one model (check.sh cross): sphere pair sa-sb and capsule pair ca-cb between
       the trees, connect (body and site semantics), weld and joint equalities across them, a spatial tendon as -> wa
       (sidesite) -> bs with a limit, and a fixed tendon over one hinge of each tree. At qpos0: |sa - sb| = 0.08 with
       radii 0.05 (overlap 0.02); ca (axis z through 0.1 0 0.3) and cb (axis y through 0.125 0 0.3) are 0.025 apart with
       radii 0.02 (overlap 0.015); every equality is satisfied; the tendon is 0.08277 long, its lower limit 0.0826. wa sits 0.01 off the as-bs line:
       on the line the wrap side is undecided and MuJoCo itself flips branch on float32 input rounding (ten_length floor 0.7);
       off it the floor is 3e-8.
       The always-active weld A-B keeps both trees one MuJoCo island in every state (MuJoCo solves per island, the
       engine one block). No ground: plane-sphere and plane-capsule are not ported pair kinds. -->
  <option timestep="0.002" gravity="0 0 -9.81" noslip_iterations="5"/>
  <default>
    <geom contype="0" conaffinity="0" density="1000"/>
    <joint damping="0.05" armature="0.001"/>
  </default>
  <worldbody>
    <body name="A" pos="0 0 0.3">
      <freejoint/>
      <geom name="ga" type="box" size="0.05 0.05 0.05"/>
      <body name="A1" pos="0 0 -0.1">
        <joint name="ja1" type="hinge" axis="0 1 0"/>
        <geom name="ga1" type="capsule" size="0.02 0.05"/>
        <body name="A2" pos="0 0 -0.1">
          <joint name="ja2" type="ball"/>
          <geom name="sa" type="sphere" size="0.05"/>
          <site name="as" pos="0 0 0"/>
          <geom name="wa" type="sphere" size="0.02" pos="0.03 -0.01 0"/>
          <site name="wside" pos="0.03 0.03 0"/>
          <site name="ka" pos="0.04 0.03 0"/>
        </body>
      </body>
      <body name="A3" pos="0.1 0 0">
        <joint name="ja3" type="slide" axis="1 0 0"/>
        <geom name="ca" type="capsule" size="0.02 0.05"/>
      </body>
    </body>
    <body name="B" pos="0.08 0 0.1">
      <freejoint/>
      <geom name="gb" type="box" size="0.05 0.05 0.05"/>
      <body name="B1" pos="0 0 0">
        <joint name="jb1" type="hinge" axis="1 0 0"/>
        <geom name="gb1" type="sphere" size="0.01"/>
        <body name="B2" pos="0 0 0">
          <joint name="jb2" type="hinge" axis="0 0 1"/>
          <geom name="sb" type="sphere" size="0.05"/>
          <site name="bs" pos="0 0 0"/>
          <site name="kb" pos="-0.04 0.03 0"/>
        </body>
      </body>
      <body name="B3" pos="0.045 0 0.2">
        <joint name="jb3" type="slide" axis="0 1 0"/>
        <geom name="cb" type="capsule" size="0.02 0.05" quat="0.70710678 0.70710678 0 0"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <pair geom1="sa" geom2="sb" condim="3" friction="0.8 0.8 0.005 0.0001 0.0001" margin="0.002"/>
    <pair geom1="ca" geom2="cb" condim="3" friction="0.8 0.8 0.005 0.0001 0.0001" margin="0.002"/>
  </contact>
  <equality>
    <weld body1="A" body2="B" relpose="0.08 0 -0.2 1 0 0 0" torquescale="1.5"/>
    <connect body1="A2" body2="B2" anchor="0.04 0 0"/>
    <connect site1="ka" site2="kb"/>
    <joint joint1="ja1" joint2="jb1" polycoef="0 0.7 0.2 -0.1 0.05"/>
  </equality>
  <tendon>
    <spatial name="ts" stiffness="5" damping="0.05" limited="true" range="0.0826 0.2">
      <site site="as"/>
      <geom geom="wa" sidesite="wside"/>
      <site site="bs"/>
    </spatial>
    <fixed name="tf" stiffness="2">
      <joint joint="ja1" coef="1"/>
      <joint joint="jb1" coef="0.5"/>
    </fixed>
  </tendon>
</mujoco>
